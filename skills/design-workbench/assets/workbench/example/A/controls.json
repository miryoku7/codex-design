{
  "version": 1,
  "tokens": {
    "accent": "#4856a0",
    "background": "#fdfdfc",
    "text": "#333541",
    "spacing": 25,
    "fontSize": 16,
    "radius": 0
  },
  "tweaks": [
    {
      "id": "titleSize",
      "label": "見出しの大きさ",
      "type": "range",
      "cssVar": "--title-size",
      "default": 36,
      "min": 28,
      "max": 46,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "artHeight",
      "label": "作品の高さ",
      "type": "range",
      "cssVar": "--art-height",
      "default": 220,
      "min": 170,
      "max": 300,
      "step": 1,
      "unit": "px"
    },
    {
      "id": "type",
      "label": "見出しの書体",
      "type": "select",
      "attribute": "data-type",
      "default": "serif",
      "options": [
        {
          "value": "serif",
          "label": "明朝"
        },
        {
          "value": "sans",
          "label": "ゴシック"
        }
      ]
    },
    {
      "id": "layout",
      "label": "余白のリズム",
      "type": "select",
      "attribute": "data-layout",
      "default": "relaxed",
      "options": [
        {
          "value": "relaxed",
          "label": "ゆったり"
        },
        {
          "value": "compact",
          "label": "コンパクト"
        }
      ]
    }
  ]
}
